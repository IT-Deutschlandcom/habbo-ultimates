<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional: Wenn die Website-Wurzel NICHT auf "public" zeigt, leitet diese Datei alles nach /public um
     und sperrt app/, database/, storage/ und config.php. Empfohlen ist trotzdem: Web-Root = public. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="app" /><add segment="database" /><add segment="storage" /><add segment="tools" /><add segment="tests" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true"><add fileExtension=".sql" allowed="false" /></fileExtensions>
        <denyUrlSequences><add sequence="config.php" /></denyUrlSequences>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Nach public" stopProcessing="true">
          <match url="^(?!public/)(.*)$" />
          <action type="Rewrite" url="public/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
